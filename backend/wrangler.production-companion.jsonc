{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "furnio-mobile",
  "account_id": "414fde01446debc02bbdd49e29e3a875",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "mobile-api.furnio.ai", "custom_domain": true},
    {"pattern": "furnio.ai/v1/challenge", "zone_name": "furnio.ai"}
  ],
  "observability": {"enabled": true, "redact_query_string": true, "logs": {"enabled": true, "invocation_logs": false}},
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://sgsjkgfwgxmlqcgyuyeh.supabase.co",
    "SUPABASE_PROJECT_REF": "sgsjkgfwgxmlqcgyuyeh",
    "MOBILE_ENABLED": "true",
    "MOBILE_BILLING_READ_ENABLED": "true",
    "MOBILE_ACTIVITY_READ_ENABLED": "true",
    "NATIVE_RECONCILIATION_ENABLED": "true",
    "NATIVE_ACQUISITION_ENABLED": "true",
    "MOBILE_NOTIFICATIONS_ENABLED": "false",
    "MOBILE_ACCOUNT_REVIEW_ENABLED": "true",
    "MOBILE_ACCOUNT_REQUESTS_ENABLED": "true",
    "MOBILE_ACCOUNT_CLEANUP_ENABLED": "false",
    "MOBILE_ACCOUNT_AUTH_BLOCK_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEhr66dsL3Z-R16K",
    "CHALLENGE_HOSTNAME": "mobile-api.furnio.ai",
    "REVENUECAT_PROJECT_ID": "7d9afb63",
    "REVENUECAT_APP_IDS": "app7734690df5",
    "EXPO_PROJECT_ID": ""
  },
  "secrets": {"required": ["SUPABASE_SERVICE_ROLE_KEY", "ACCOUNT_DELETION_LIMIT_SECRET"]},
  "ratelimits": [
    {"name": "ACCOUNT_DELETION_SOURCE_LIMIT", "namespace_id": "2026091001", "simple": {"limit": 120, "period": 60}},
    {"name": "ACCOUNT_DELETION_USER_LIMIT", "namespace_id": "2026091002", "simple": {"limit": 10, "period": 60}},
    {"name": "ACCOUNT_DELETION_RECEIPT_LIMIT", "namespace_id": "2026091003", "simple": {"limit": 12, "period": 60}}
  ],
  "services": [{"binding": "PLATFORM", "service": "virtual-staging-api"}],
  "queues": {
    "producers": [{"binding": "NATIVE_EVENTS", "queue": "furnio-mobile-native-events"}],
    "consumers": [{
      "queue": "furnio-mobile-native-events",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 10,
      "retry_delay": 60,
      "dead_letter_queue": "furnio-mobile-native-events-dlq"
    }]
  }
}
