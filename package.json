{
  "name": "furnio-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web --port 4340",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ledger": "node scripts/test-ledger.mjs",
    "check:contracts": "node scripts/sync-contracts.mjs --check",
    "check:account-inventory": "node scripts/check-account-inventory.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm check:contracts",
    "export:preview": "EXPO_PUBLIC_APP_MODE=demo expo export --platform web",
    "worker:types": "wrangler types --config backend/wrangler.jsonc --strict-vars false backend/worker-configuration.d.ts",
    "worker:check": "tsc --project backend/tsconfig.json --noEmit",
    "worker:build": "wrangler deploy --config backend/wrangler.jsonc --dry-run --outdir backend/dist"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@expo-google-fonts/instrument-serif": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "2.116.0",
    "expo": "57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "libphonenumber-js": "1.13.12",
    "lucide-react-native": "1.43.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "10.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "@react-native/metro-config": "0.86.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.4",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.129.1"
  }
}
