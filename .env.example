# No credentials are needed for the labelled, offline demo.
EXPO_PUBLIC_APP_MODE=demo
# Only fill these with a separately approved staging project. Never copy service-role keys.
EXPO_PUBLIC_PLATFORM_API_URL=
EXPO_PUBLIC_MOBILE_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
# Remain false until staging acceptance. Native purchases also require the server gate.
EXPO_PUBLIC_PURCHASES_ENABLED=false
