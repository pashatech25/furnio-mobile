# No credentials are needed for the labelled, offline demo.
EXPO_PUBLIC_APP_MODE=demo
# Only fill these with a separately approved staging project. Never copy service-role keys.
EXPO_PUBLIC_PLATFORM_API_URL=
EXPO_PUBLIC_MOBILE_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Separate public pk. token for native maps; website URL-restricted keys will not work.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
EXPO_PUBLIC_EAS_PROJECT_ID=
# Website-only purchases for v1. No RevenueCat keys or native checkout setup.
# The app also has a non-environment commerce guard; do not enable this flag.
EXPO_PUBLIC_PURCHASES_ENABLED=false
